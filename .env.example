# Public site origin used for metadataBase, sitemap, robots, and JSON-LD.
# Set this to the production domain before launch (include https://, no trailing slash).
NEXT_PUBLIC_SITE_URL=https://rurango.com

# Contact form delivery via Resend (https://resend.com)
# All three are required before submissions are accepted.
# 1) Create a Resend account and API key.
# 2) Add and verify rurango.com in Resend (DNS: SPF, DKIM — usually MX too).
# 3) CONTACT_FROM_EMAIL must use that verified domain, e.g. contact@rurango.com
# 4) CONTACT_TO_EMAIL is where inquiries arrive (can be Gmail while you set up inbox).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=contact@rurango.com
